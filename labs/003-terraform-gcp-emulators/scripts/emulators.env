# source scripts/emulators.env
# Points Terraform (Bigtable) and gcloud at the local emulators.
# gcloud gets its own empty config folder, so your real login is never used.

export BIGTABLE_EMULATOR_HOST=localhost:8086

export CLOUDSDK_CONFIG="$PWD/.gcloud-local"
mkdir -p "$CLOUDSDK_CONFIG" && echo owner > "$CLOUDSDK_CONFIG/token"
export CLOUDSDK_AUTH_ACCESS_TOKEN_FILE="$CLOUDSDK_CONFIG/token"
export CLOUDSDK_CORE_PROJECT=jaylabs-local
export CLOUDSDK_API_ENDPOINT_OVERRIDES_STORAGE=http://localhost:4443/storage/v1/
export CLOUDSDK_API_ENDPOINT_OVERRIDES_PUBSUB=http://localhost:8085/
export CLOUDSDK_API_ENDPOINT_OVERRIDES_SPANNER=http://localhost:9020/
